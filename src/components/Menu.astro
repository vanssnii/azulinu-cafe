---
const menuFiles = await (Astro as any).glob('../content/menu/*.md');

const items = menuFiles
  .filter((item: any) => item.frontmatter.disponible)
  .map((item: any) => item.frontmatter);

const categorias = [...new Set(items.map((item: any) => (item as any).categoria))] as string[];
---

<section class="menu" id="menu">
  <div class="menu__inner">
    <p class="menu__eyebrow">Lo que ofrecemos</p>
    <h2 class="menu__title">Nuestro menú</h2>

    {categorias.length === 0 ? (
      <p class="menu__vacio">Menú en preparación.</p>
    ) : (
      categorias.map((categoria) => (
        <div class="menu__categoria">
          <h3 class="menu__categoria-nombre">{categoria}</h3>
          <div class="menu__items">
            {items
             .filter((item: any) => item.categoria === categoria)
             .map((item: any) => (
                <div class="menu__item">
                  {item.imagen && (
                    <div class="menu__item-imagen">
                      <img src={item.imagen} alt={item.nombre} />
                    </div>
                  )}
                  <div class="menu__item-info">
                    <p class="menu__item-nombre">{item.nombre}</p>
                    <p class="menu__item-descripcion">{item.descripcion}</p>
                  </div>
                  <p class="menu__item-precio">${item.precio}</p>
                </div>
              ))
            }
          </div>
        </div>
      ))
    )}
  </div>
</section>

<style>
  .menu {
    padding: var(--space-2xl) var(--space-lg);
    background-color: var(--color-surface);
  }

  .menu__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .menu__eyebrow {
    font-size: var(--text-sm);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .menu__title {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    margin-bottom: var(--space-xl);
  }

  .menu__vacio {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .menu__categoria {
    margin-bottom: var(--space-xl);
  }

  .menu__categoria-nombre {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .menu__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .menu__item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .menu__item-imagen {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .menu__item-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu__item-info {
    flex: 1;
  }

  .menu__item-nombre {
    font-size: var(--text-base);
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .menu__item-descripcion {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .menu__item-precio {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    color: var(--color-accent);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .menu {
      padding: var(--space-xl) var(--space-md);
    }
  }
</style>