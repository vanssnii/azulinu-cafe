---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display&family=Inter:wght@400;500&display=swap"
    />
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      (function () {
        var ni = window.netlifyIdentity;
        if (!ni) return;

        var hash = window.location.hash || "";
        var hasAuthToken =
          hash.indexOf("invite_token=") !== -1 ||
          hash.indexOf("recovery_token=") !== -1 ||
          hash.indexOf("confirmation_token=") !== -1;

        ni.on("init", function (user) {
          if (!user) {
            ni.on("login", function () {
              document.location.href = "/admin/";
            });
          }
          if (hasAuthToken) {
            ni.open();
          }
        });
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>